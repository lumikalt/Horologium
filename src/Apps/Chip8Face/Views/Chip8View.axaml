<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chip8Face.ViewModels"
             x:Class="Chip8Face.Views.Chip8View"
             x:DataType="vm:Chip8ViewModel"
             Focusable="True"
             KeyDown="OnKeyDown"
             KeyUp="OnKeyUp">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Toolbar -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Content="Load ROM…"
                        Click="OnLoadRomClick"
                        Margin="0,0,6,0"
                        Padding="10,4" />
                <Button DockPanel.Dock="Left"
                        Content="{Binding StartPauseLabel}"
                        Command="{Binding StartPauseCommand}"
                        Margin="0,0,6,0"
                        Padding="10,4" />
                <Button DockPanel.Dock="Left"
                        Content="Reset"
                        Command="{Binding ResetCommand}"
                        Padding="10,4" />
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           Opacity="0.6"
                           FontSize="12" />
            </DockPanel>
        </Border>

        <!-- Display canvas (64×32 → 640×320) -->
        <Grid Grid.Row="1" Background="#0A0A0A">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="#333333"
                    BorderThickness="2">
                <Image x:Name="DisplayImage"
                       Source="{Binding Bitmap}"
                       Width="640" Height="320"
                       RenderOptions.BitmapInterpolationMode="None"
                       Stretch="Fill" />
            </Border>
        </Grid>

        <!-- Key layout hint -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock FontFamily="{StaticResource MonoFont}"
                       FontSize="11"
                       Opacity="0.45"
                       Text="Keys: [1][2][3][4] [Q][W][E][R] [A][S][D][F] [Z][X][C][V]  →  CHIP-8: 1 2 3 C | 4 5 6 D | 7 8 9 E | A 0 B F" />
        </Border>

    </Grid>

</UserControl>
