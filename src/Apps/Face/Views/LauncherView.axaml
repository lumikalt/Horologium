<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Face.ViewModels"
             x:Class="Face.Views.LauncherView"
             x:DataType="vm:MainWindowViewModel">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="40">

            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="Horologium"
                           FontSize="42" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="CPU Architecture Simulator"
                           FontSize="16" Opacity="0.5"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center">

                <Button Command="{Binding GoToRiscVCommand}"
                        Width="220" Height="130"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="RISC-V"
                                   FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="RV32IMAFCV pipeline simulator"
                                   FontSize="12" Opacity="0.6"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding GoToChip8Command}"
                        Width="220" Height="130"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="CHIP-8"
                                   FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="64×32 pixel virtual machine"
                                   FontSize="12" Opacity="0.6"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Button>

            </StackPanel>

        </StackPanel>
    </Grid>

</UserControl>