                                                       Minimum="0" Maximum="256" Increment="1"
                                                       FormatString="N0"
                                                       HorizontalAlignment="Stretch" />
                                        <TextBlock Grid.Column="2" Text="B"
                                                   VerticalAlignment="Center" FontSize="11" Opacity="0.6" />
                                    </Grid>
                                    <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0" Text="Victim"
                                                   VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                        <NumericUpDown Grid.Column="1"
                                                       Value="{Binding Assembler.L2CacheVictimCacheEntries}"
                                                       Minimum="0" Maximum="32" Increment="1"
                                                       FormatString="N0"
                                                       HorizontalAlignment="Stretch" />
                                        <TextBlock Grid.Column="2" Text="ln"
                                                   VerticalAlignment="Center" FontSize="11" Opacity="0.6" />
                                    </Grid>
                                    <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0" Text="Vic. lat"
                                                   VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                        <NumericUpDown Grid.Column="1"
                                                       Value="{Binding Assembler.L2CacheVictimCacheHitLatency}"
                                                       Minimum="1" Maximum="500" Increment="1"
                                                       FormatString="N0"
                                                       HorizontalAlignment="Stretch" />
                                        <TextBlock Grid.Column="2" Text="cy"
                                                   VerticalAlignment="Center" FontSize="11" Opacity="0.6" />
                                    </Grid>
                                    <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0" Text="Inclusion"
                                                   VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Assembler.InclusionPolicyOptions}"
                                                  SelectedItem="{Binding Assembler.L2CacheInclusionPolicy}"
                                                  HorizontalAlignment="Stretch" />
                                        <TextBlock Grid.Column="2" Text="  "
                                                   VerticalAlignment="Center" FontSize="11" />
                                    </Grid>
                                    <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0" Text="Compress"
                                                   VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Assembler.CompressionOptions}"
                                                  SelectedItem="{Binding Assembler.L2CacheCompression}"
                                                  HorizontalAlignment="Stretch" />
                                        <TextBlock Grid.Column="2" Text="  "
                                                   VerticalAlignment="Center" FontSize="11" />
                                    </Grid>
                                    <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0" Text="Segment"
                                                   VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                        <NumericUpDown Grid.Column="1"
                                                       Value="{Binding Assembler.L2CacheSegmentBytes}"
                                                       Minimum="1" Maximum="64" Increment="1"
                                                       FormatString="N0"
                                                       HorizontalAlignment="Stretch" />
                                        <TextBlock Grid.Column="2" Text="B"
                                                   VerticalAlignment="Center" FontSize="11" Opacity="0.6" />
                                    </Grid>
                                </StackPanel>

                                <!-- Replacement policy (applies to all enabled cache levels) -->
                                <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="4" Margin="12,0,0,0">
                                    <TextBlock Grid.Column="0" Text="Policy"
                                               VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Assembler.CacheReplacementPolicyOptions}"
                                              SelectedItem="{Binding Assembler.CacheReplacementPolicy}"
                                              HorizontalAlignment="Stretch" />
                                    <TextBlock Grid.Column="2" Text="  "
                                               VerticalAlignment="Center" FontSize="11" />
                                </Grid>

                                <TextBlock Text="Toggle applies immediately. Geometry takes effect on Reset."
                                           FontSize="10" Opacity="0.4" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- OoO structural parameters -->
                            <StackPanel IsVisible="{Binding Assembler.IsOooMode}"
                                        Margin="16,0,16,4" Spacing="4">
                                <TextBlock Text="OOO PIPELINE" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                                <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="4"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Issue W"
                                               VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                                   Value="{Binding Assembler.OooIssueWidth}"
                                                   Minimum="1" Maximum="16" FormatString="N0"
                                                   HorizontalAlignment="Stretch" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="  "
                                               VerticalAlignment="Center" FontSize="11" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ROB"
                                               VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                                   Value="{Binding Assembler.OooRobCapacity}"
                                                   Minimum="4" Maximum="512" FormatString="N0"
                                                   HorizontalAlignment="Stretch" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="  "
                                               VerticalAlignment="Center" FontSize="11" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="IQ"
                                               VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                    <NumericUpDown Grid.Row="2" Grid.Column="1"
                                                   Value="{Binding Assembler.OooIqCapacity}"
                                                   Minimum="4" Maximum="256" FormatString="N0"
                                                   HorizontalAlignment="Stretch" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="  "
                                               VerticalAlignment="Center" FontSize="11" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Phys regs"
                                               VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                    <NumericUpDown Grid.Row="3" Grid.Column="1"
                                                   Value="{Binding Assembler.OooExtraPhysRegs}"
                                                   Minimum="0" Maximum="256" FormatString="N0"
                                                   HorizontalAlignment="Stretch" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="  "
                                               VerticalAlignment="Center" FontSize="11" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="MSHR"
                                               VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                    <NumericUpDown Grid.Row="4" Grid.Column="1"
                                                   Value="{Binding Assembler.OooMshrCapacity}"
                                                   Minimum="0" Maximum="64" FormatString="N0"
                                                   HorizontalAlignment="Stretch" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="  "
                                               VerticalAlignment="Center" FontSize="11" Opacity="0.5" />

                                    <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                                              Content="Flat IQ"
                                              IsChecked="{Binding Assembler.OooFlatIq}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="16,12,16,12" Spacing="12">
                                <TextBlock Text="ASSEMBLER" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />

                                <!-- ms / cycle chooser -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="ms / cycle" FontSize="11" Opacity="0.55" />
                                    <NumericUpDown Value="{Binding Assembler.MsPerCycle}"
                                                   Minimum="0" Maximum="5000"
                                                   Increment="10" FormatString="N0"
                                                   HorizontalAlignment="Stretch" />
                                    <TextBlock Text="0 = run as fast as possible."
                                               FontSize="11" Opacity="0.45" />
                                </StackPanel>

                                <!-- Transport buttons: ←  |▶  →  ↺ -->
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                    <Button Grid.Column="0" Content="←"
                                            Command="{Binding Assembler.BackCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            FontSize="16" Padding="0,8" />
                                    <Button Grid.Column="1" Content="|▶"
                                            Command="{Binding Assembler.RunCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            FontSize="16" Padding="0,8" />
                                    <Button Grid.Column="2" Content="→"
                                            Command="{Binding Assembler.StepCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            FontSize="16" Padding="0,8" />
                                    <Button Grid.Column="3" Content="↺"
                                            Command="{Binding Assembler.ResetCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            FontSize="16" Padding="0,8" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                    <TextBlock Grid.Column="0" Text="Back"
                                               TextAlignment="Center" FontSize="10" Opacity="0.45" />
                                    <TextBlock Grid.Column="1" Text="Run"
                                               TextAlignment="Center" FontSize="10" Opacity="0.45" />
                                    <TextBlock Grid.Column="2" Text="Step"
                                               TextAlignment="Center" FontSize="10" Opacity="0.45" />
                                    <TextBlock Grid.Column="3" Text="Reset"
                                               TextAlignment="Center" FontSize="10" Opacity="0.45" />
                                </Grid>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── Right panel: results ─────────────────────────────────────────── -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Status bar -->
            <Border Grid.Row="0" Padding="12,8"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding StatusText}" Opacity="0.75" />
            </Border>

            <!-- Tabs -->
            <TabControl Grid.Row="1" x:Name="ResultsTabControl" SelectedIndex="{Binding SelectedTabIndex}">

                <!-- Charts tab (Chart + Table as sub-tabs) -->
                <TabItem Header="Charts">
                    <TabControl>
                        <TabItem Header="Chart">
                            <Grid RowDefinitions="Auto,*">
                                <DockPanel Grid.Row="0" Margin="12,8" LastChildFill="True">
                                    <TextBlock Text="Metric: " DockPanel.Dock="Left"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding AvailableMetrics}"
                                              SelectedItem="{Binding SelectedMetric}"
                                              MinWidth="240" />
                                </DockPanel>
                                <sp:AvaPlot x:Name="ChartView" Grid.Row="1" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Table">
                            <DataGrid x:Name="ResultsGrid"
                                      IsReadOnly="True"
                                      CanUserSortColumns="True"
                                      CanUserResizeColumns="True"
                                      GridLinesVisibility="All"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto" />
                        </TabItem>
                        <TabItem Header="Waveform">
                            <Grid ColumnDefinitions="260,*">

                                <!-- Signal picker -->
                                <Border Grid.Column="0"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                        BorderThickness="0,0,1,0">
                                    <Grid RowDefinitions="Auto,Auto,*" Margin="12,8">
                                        <TextBlock Grid.Row="0" Text="SIGNALS"
                                                   FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                                        <CheckBox Grid.Row="1"
                                                  Content="Cumulative counters"
                                                  IsChecked="{Binding WaveformCumulative}"
                                                  ToolTip.Tip="Plot raw cumulative counter values instead of per-window deltas."
                                                  Margin="0,6,0,4" />
                                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AvailableSignals}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SignalToggle">
                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  Content="{Binding Name}"
                                                                  FontSize="12"
                                                                  Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- Plot -->
                                <Grid Grid.Column="1" RowDefinitions="Auto,*">
                                    <Border Grid.Row="0" Padding="12,7"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                            BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding WaveformStatusText}"
                                                   Opacity="0.75" FontSize="12" />
                                    </Border>
                                    <sp:AvaPlot x:Name="WaveformView" Grid.Row="1" />
                                </Grid>

                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <!-- PEvents tab -->
                <TabItem Header="PEvents">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Padding="12,7"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Save Image"
                                        FontSize="12"
                                        Padding="10,2"
                                        IsEnabled="{Binding CurrentWaterfall, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        Click="OnSaveWaterfallClick" />
                                <TextBlock Text="{Binding PEventStatusText}" Opacity="0.75" FontSize="12"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      PointerMoved="OnWaterfallPointerMoved"
                                      PointerExited="OnWaterfallPointerExited">
                            <controls:WaterfallControl x:Name="WaterfallCtrl"
                                                       Data="{Binding CurrentWaterfall}"
                                                       IsDark="{Binding IsDarkTheme}" />
                        </ScrollViewer>

                        <!-- Hover info card — Canvas is non-hit-testable so scroll passes through -->
                        <Canvas x:Name="InstrOverlay" Grid.Row="1" IsHitTestVisible="False">
                            <Border x:Name="InstrCard"
                                    IsVisible="False"
                                    Background="#EE252535"
                                    BorderBrush="#5A5A80"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,10"
                                    MinWidth="260"
                                    MaxWidth="480">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="PopupPcLine"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="#A0C8FF"
                                               FontWeight="Bold" />
                                    <TextBlock x:Name="PopupDisasmLine"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="13"
                                               Foreground="#E0E0F0"
                                               Margin="0,0,0,4" />
                                    <TextBlock x:Name="PopupStages"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="#A0B0C8" />
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Grid>
                </TabItem>

                <!-- Assembler tab (CPU + UVE Kernel as sub-tabs) -->
                <TabItem Header="Assembler">
                    <TabControl SelectedIndex="{Binding AssemblerSubTabIndex}">
                        <TabItem Header="CPU">
                            <views:AssemblerView DataContext="{Binding Assembler}" />
                        </TabItem>
                        <TabItem Header="UVE Kernel">
                            <Grid RowDefinitions="*,Auto,140">
                                <avEdit:TextEditor Grid.Row="0"
                                                   x:Name="SourceEditor"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="13"
                                                   ShowLineNumbers="True"
                                                   WordWrap="False"
                                                   HorizontalScrollBarVisibility="Auto"
                                                   VerticalScrollBarVisibility="Auto"
                                                   Margin="8" />
                                <TextBlock Grid.Row="1" Text="CONSOLE OUTPUT"
                                           FontSize="11" FontWeight="SemiBold" Opacity="0.55"
                                           Margin="8,0,8,4" />
                                <TextBox Grid.Row="2"
                                         Text="{Binding ConsoleOutput}"
                                         IsReadOnly="True"
                                         FontFamily="{StaticResource MonoFont}"
                                         FontSize="12"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         Margin="8,0,8,8" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

            </TabControl>
        </Grid>

    </Grid>
</UserControl>