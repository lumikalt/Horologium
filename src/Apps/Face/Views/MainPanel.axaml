<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Face.ViewModels"
             xmlns:views="using:Face.Views"
             xmlns:controls="using:Face.Controls"
             xmlns:models="using:Face.Models"
             xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:avEdit="using:AvaloniaEdit"
             x:Class="Face.Views.MainPanel"
             x:DataType="vm:MainWindowViewModel">

    <!-- Shared config-detail template — used by both Chart/Table and PEvents sidebars -->
    <UserControl.Resources>
        <DataTemplate x:Key="ConfigDetailTemplate" x:DataType="vm:ConfigViewModel">
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="12">
                <StackPanel Spacing="8">

                    <!-- Name -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Name" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Name}" />
                    </Grid>

                    <!-- Pipeline -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Pipeline" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PipelineOptions}"
                                  SelectedItem="{Binding Pipeline}"
                                  HorizontalAlignment="Stretch" />
                    </Grid>

                    <!-- five_stage: forwarding -->
                    <CheckBox IsChecked="{Binding ForwardingEnabled}"
                              Content="Forwarding enabled"
                              IsVisible="{Binding IsFiveStage}" />

                    <!-- Predictor (five_stage + ooo) -->
                    <StackPanel IsVisible="{Binding HasPredictorConfig}" Spacing="6">
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="Branch predictor" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding PredictorOptions}"
                                      SelectedItem="{Binding PredictorType}"
                                      HorizontalAlignment="Stretch" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasNBitParams}">
                            <TextBlock Grid.Column="0" Text="Bits" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding PredictorBits}"
                                           Minimum="1" Maximum="8" Increment="1" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasNBitParams}">
                            <TextBlock Grid.Column="0" Text="Table size" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding PredictorTableSize}"
                                           Minimum="4" Maximum="65536" Increment="256" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasGshareParams}">
                            <TextBlock Grid.Column="0" Text="History bits" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding PredictorHistoryBits}"
                                           Minimum="1" Maximum="32" Increment="1" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasGselectParams}">
                            <TextBlock Grid.Column="0" Text="PC bits" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding PredictorPcBits}"
                                           Minimum="1" Maximum="16" Increment="1" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasCorrelatedParams}">
                            <TextBlock Grid.Column="0" Text="M (hist bits)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding CorrelatedM}"
                                           Minimum="1" Maximum="16" Increment="1" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasCorrelatedParams}">
                            <TextBlock Grid.Column="0" Text="N (counter bits)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding CorrelatedN}"
                                           Minimum="1" Maximum="8" Increment="1" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasCorrelatedParams}">
                            <TextBlock Grid.Column="0" Text="BHT size" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding CorrelatedBhtSize}"
                                           Minimum="4" Maximum="65536" Increment="256" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasPerceptronParams}">
                            <TextBlock Grid.Column="0" Text="History length" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding PerceptronHistoryLength}"
                                           Minimum="1" Maximum="256" Increment="4" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasPerceptronParams}">
                            <TextBlock Grid.Column="0" Text="Table size" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding PerceptronTableSize}"
                                           Minimum="4" Maximum="65536" Increment="256" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasHashedPerceptronParams}">
                            <TextBlock Grid.Column="0" Text="Table size" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding HashedPerceptronTableSize}"
                                           Minimum="4" Maximum="65536" Increment="256" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasTournamentParams}">
                            <TextBlock Grid.Column="0" Text="Local hist bits" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding TournamentLocalHistoryBits}"
                                           Minimum="1" Maximum="16" Increment="1" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasTournamentParams}">
                            <TextBlock Grid.Column="0" Text="Local table" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding TournamentLocalTableSize}"
                                           Minimum="4" Maximum="65536" Increment="256" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasTournamentParams}">
                            <TextBlock Grid.Column="0" Text="Global hist bits" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding TournamentGlobalHistoryBits}"
                                           Minimum="1" Maximum="32" Increment="1" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasImliParams}">
                            <TextBlock Grid.Column="0" Text="PHT size" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding ImliPhtSize}"
                                           Minimum="64" Maximum="524288" Increment="1024" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasImliParams}">
                            <TextBlock Grid.Column="0" Text="BTB size" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding ImliBtbSize}"
                                           Minimum="64" Maximum="65536" Increment="256" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasCbpPluginParams}">
                            <TextBlock Grid.Column="0" Text="Shim .so path" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding CbpLibraryPath}"
                                     PlaceholderText="/path/to/predictor.so (native/CbpShim/build.sh output)" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasCbpNgPluginParams}">
                            <TextBlock Grid.Column="0" Text="Shim .so path" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding CbpNgLibraryPath}"
                                     PlaceholderText="/path/to/predictor.so (native/CbpNgShim/build.sh output)" />
                        </Grid>
                    </StackPanel>

                    <!-- five_stage + ooo: I-cache -->
                    <StackPanel IsVisible="{Binding HasPredictorConfig}" Spacing="6">
                        <CheckBox IsChecked="{Binding ICacheEnabled}" Content="I-cache" />
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8" Margin="12,0,0,0"
                              IsVisible="{Binding ICacheEnabled}"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              RowSpacing="4">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Capacity (KiB)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding ICacheCapacityKb}"
                                           Minimum="1" Maximum="16384" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ways" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ICacheWays}"
                                           Minimum="1" Maximum="16" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Block (bytes)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ICacheBlockBytes}"
                                           Minimum="8" Maximum="256" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Miss latency" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding ICacheMissLatency}"
                                           Minimum="1" Maximum="200" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Tag latency" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding ICacheTagLatency}"
                                           Minimum="0" Maximum="100" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Data latency" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding ICacheDataLatency}"
                                           Minimum="0" Maximum="100" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Wr.hit" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="6" Grid.Column="1"
                                      ItemsSource="{x:Static vm:ConfigViewModel.WritePolicyOptions}"
                                      SelectedItem="{Binding ICacheWritePolicy}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Wr.miss" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="7" Grid.Column="1"
                                      ItemsSource="{x:Static vm:ConfigViewModel.WriteMissPolicyOptions}"
                                      SelectedItem="{Binding ICacheWriteMissPolicy}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="WB buf (lines)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="8" Grid.Column="1" Value="{Binding ICacheWbCapacity}"
                                           Minimum="0" Maximum="32" />
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Banks" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="9" Grid.Column="1" Value="{Binding ICacheBankCount}"
                                           Minimum="1" Maximum="64" />
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Read ports" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="10" Grid.Column="1" Value="{Binding ICacheReadPorts}"
                                           Minimum="0" Maximum="16" />
                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Write ports" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="11" Grid.Column="1" Value="{Binding ICacheWritePorts}"
                                           Minimum="0" Maximum="16" />
                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Sector (bytes)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="12" Grid.Column="1" Value="{Binding ICacheSectorBytes}"
                                           Minimum="0" Maximum="256" />
                            <TextBlock Grid.Row="13" Grid.Column="0" Text="Victim entries" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="13" Grid.Column="1" Value="{Binding ICacheVictimCacheEntries}"
                                           Minimum="0" Maximum="32" />
                            <TextBlock Grid.Row="14" Grid.Column="0" Text="Victim lat." VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="14" Grid.Column="1" Value="{Binding ICacheVictimCacheHitLatency}"
                                           Minimum="1" Maximum="200" />
                        </Grid>
                        <StackPanel Margin="12,0,0,0" Spacing="4"
                                    IsVisible="{Binding ICacheEnabled}">
                            <CheckBox IsChecked="{Binding FdipEnabled}"
                                      Content="FDIP (fetch-directed prefetch)" />
                            <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                                  IsVisible="{Binding HasFdipFtqCapacity}">
                                <TextBlock Grid.Column="0" Text="FTQ capacity" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding FdipFtqCapacity}"
                                               Minimum="1" Maximum="256" />
                            </Grid>
                            <CheckBox IsChecked="{Binding RdipEnabled}"
                                      Content="RDIP (RAS-directed prefetch)" />
                        </StackPanel>
                    </StackPanel>

                    <!-- five_stage + ooo: D-cache -->
                    <StackPanel IsVisible="{Binding HasPredictorConfig}" Spacing="6">
                        <CheckBox IsChecked="{Binding DCacheEnabled}" Content="D-cache" />
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8" Margin="12,0,0,0"
                              IsVisible="{Binding DCacheEnabled}"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              RowSpacing="4">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Capacity (KiB)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding DCacheCapacityKb}"
                                           Minimum="1" Maximum="16384" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ways" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding DCacheWays}"
                                           Minimum="1" Maximum="16" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Block (bytes)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding DCacheBlockBytes}"
                                           Minimum="8" Maximum="256" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Miss latency" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding DCacheMissLatency}"
                                           Minimum="1" Maximum="200" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Tag latency" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding DCacheTagLatency}"
                                           Minimum="0" Maximum="100" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Data latency" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding DCacheDataLatency}"
                                           Minimum="0" Maximum="100" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Wr.hit" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="6" Grid.Column="1"
                                      ItemsSource="{x:Static vm:ConfigViewModel.WritePolicyOptions}"
                                      SelectedItem="{Binding DCacheWritePolicy}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Wr.miss" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="7" Grid.Column="1"
                                      ItemsSource="{x:Static vm:ConfigViewModel.WriteMissPolicyOptions}"
                                      SelectedItem="{Binding DCacheWriteMissPolicy}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="WB buf (lines)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="8" Grid.Column="1" Value="{Binding DCacheWbCapacity}"
                                           Minimum="0" Maximum="32" />
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Banks" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="9" Grid.Column="1" Value="{Binding DCacheBankCount}"
                                           Minimum="1" Maximum="64" />
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Read ports" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="10" Grid.Column="1" Value="{Binding DCacheReadPorts}"
                                           Minimum="0" Maximum="16" />
                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Write ports" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="11" Grid.Column="1" Value="{Binding DCacheWritePorts}"
                                           Minimum="0" Maximum="16" />
                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Sector (bytes)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="12" Grid.Column="1" Value="{Binding DCacheSectorBytes}"
                                           Minimum="0" Maximum="256" />
                            <TextBlock Grid.Row="13" Grid.Column="0" Text="Victim entries" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="13" Grid.Column="1" Value="{Binding DCacheVictimCacheEntries}"
                                           Minimum="0" Maximum="32" />
                            <TextBlock Grid.Row="14" Grid.Column="0" Text="Victim lat." VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="14" Grid.Column="1" Value="{Binding DCacheVictimCacheHitLatency}"
                                           Minimum="1" Maximum="200" />
                        </Grid>
                        <StackPanel Margin="12,0,0,0" Spacing="4"
                                    IsVisible="{Binding DCacheEnabled}">
                            <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Prefetcher" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Static vm:ConfigViewModel.DPrefetcherOptions}"
                                          SelectedItem="{Binding DPrefetcher}"
                                          HorizontalAlignment="Stretch" />
                            </Grid>
                            <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                                  IsVisible="{Binding HasDPrefetcherTableSize}">
                                <TextBlock Grid.Column="0" Text="Table size" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding DPrefetcherTableSize}"
                                               Minimum="1" Maximum="1024" />
                            </Grid>
                            <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                                  IsVisible="{Binding HasDPrefetcherDepth}">
                                <TextBlock Grid.Column="0" Text="Depth (lines)" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding DPrefetcherDepth}"
                                               Minimum="1" Maximum="64" />
                            </Grid>
                            <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                                  IsVisible="{Binding HasDPrefetcherParams}">
                                <TextBlock Grid.Column="0" Text="Prefetch lat." VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding DPrefetchLatency}"
                                               Minimum="0" Maximum="100" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- five_stage + ooo: unified L2 cache -->
                    <StackPanel IsVisible="{Binding HasPredictorConfig}" Spacing="6">
                        <CheckBox IsChecked="{Binding L2CacheEnabled}" Content="L2 cache (unified)" />
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8" Margin="12,0,0,0"
                              IsVisible="{Binding L2CacheEnabled}"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              RowSpacing="4">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Capacity (KiB)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding L2CacheCapacityKb}"
                                           Minimum="1" Maximum="131072" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ways" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding L2CacheWays}"
                                           Minimum="1" Maximum="32" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Block (bytes)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding L2CacheBlockBytes}"
                                           Minimum="8" Maximum="256" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Miss latency" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding L2CacheMissLatency}"
                                           Minimum="1" Maximum="500" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Tag latency" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding L2CacheTagLatency}"
                                           Minimum="0" Maximum="100" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Data latency" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding L2CacheDataLatency}"
                                           Minimum="0" Maximum="100" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Wr.hit" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="6" Grid.Column="1"
                                      ItemsSource="{x:Static vm:ConfigViewModel.WritePolicyOptions}"
                                      SelectedItem="{Binding L2CacheWritePolicy}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Wr.miss" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="7" Grid.Column="1"
                                      ItemsSource="{x:Static vm:ConfigViewModel.WriteMissPolicyOptions}"
                                      SelectedItem="{Binding L2CacheWriteMissPolicy}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="WB buf (lines)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="8" Grid.Column="1" Value="{Binding L2CacheWbCapacity}"
                                           Minimum="0" Maximum="64" />
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Banks" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="9" Grid.Column="1" Value="{Binding L2CacheBankCount}"
                                           Minimum="1" Maximum="64" />
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Read ports" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="10" Grid.Column="1" Value="{Binding L2CacheReadPorts}"
                                           Minimum="0" Maximum="16" />
                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Write ports" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="11" Grid.Column="1" Value="{Binding L2CacheWritePorts}"
                                           Minimum="0" Maximum="16" />
                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Sector (bytes)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="12" Grid.Column="1" Value="{Binding L2CacheSectorBytes}"
                                           Minimum="0" Maximum="256" />
                            <TextBlock Grid.Row="13" Grid.Column="0" Text="Victim entries" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="13" Grid.Column="1" Value="{Binding L2CacheVictimCacheEntries}"
                                           Minimum="0" Maximum="32" />
                            <TextBlock Grid.Row="14" Grid.Column="0" Text="Victim lat." VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="14" Grid.Column="1" Value="{Binding L2CacheVictimCacheHitLatency}"
                                           Minimum="1" Maximum="500" />
                            <TextBlock Grid.Row="15" Grid.Column="0" Text="Inclusion" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="15" Grid.Column="1"
                                      ItemsSource="{x:Static vm:ConfigViewModel.InclusionPolicyOptions}"
                                      SelectedItem="{Binding L2CacheInclusionPolicy}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="16" Grid.Column="0" Text="Compression" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="16" Grid.Column="1"
                                      ItemsSource="{x:Static vm:ConfigViewModel.CompressionOptions}"
                                      SelectedItem="{Binding L2CacheCompression}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="17" Grid.Column="0" Text="Segment (bytes)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="17" Grid.Column="1" Value="{Binding L2CacheSegmentBytes}"
                                           Minimum="1" Maximum="64" />
                        </Grid>
                    </StackPanel>

                    <!-- five_stage + ooo: cache replacement policy -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                          IsVisible="{Binding HasPredictorConfig}">
                        <TextBlock Grid.Column="0" Text="DoCache policy" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{x:Static vm:ConfigViewModel.CacheReplacementPolicyOptions}"
                                  SelectedItem="{Binding CacheReplacementPolicy}"
                                  HorizontalAlignment="Stretch" />
                    </Grid>

                    <!-- five_stage: store buffer (not exposed for ooo — handled internally) -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                          IsVisible="{Binding IsFiveStage}">
                        <TextBlock Grid.Column="0" Text="Store buffer" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding StoreBufferCapacity}"
                                       Minimum="0" Maximum="64" />
                    </Grid>

                    <!-- superscalar / ooo / cpr: issue width -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                          IsVisible="{Binding IsWidePipeline}">
                        <TextBlock Grid.Column="0" Text="Issue width" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding IssueWidth}"
                                       Minimum="1" Maximum="16" />
                    </Grid>

                    <!-- cpr: IQ / phys regs (checkpoint geometry stays at train defaults) -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                          RowDefinitions="Auto,Auto" RowSpacing="4"
                          IsVisible="{Binding IsCpr}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="IQ capacity" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding IqCapacity}"
                                       Minimum="4" Maximum="256" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Extra phys regs" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ExtraPhysRegs}"
                                       Minimum="0" Maximum="256" />
                    </Grid>

                    <!-- dae: per-lane queue depth -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                          IsVisible="{Binding IsDae}">
                        <TextBlock Grid.Column="0" Text="Lane queue depth" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding DaeLaneQueueDepth}"
                                       Minimum="1" Maximum="64" />
                    </Grid>

                    <!-- ooo: ROB / IQ / phys regs / flat IQ / MSHR -->
                    <StackPanel IsVisible="{Binding IsOoo}" Spacing="6">
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ROB capacity" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding RobCapacity}"
                                           Minimum="4" Maximum="512" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="IQ capacity" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding IqCapacity}"
                                           Minimum="4" Maximum="256" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Extra phys regs" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ExtraPhysRegs}"
                                           Minimum="0" Maximum="256" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="MSHR capacity" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding MshrCapacity}"
                                           Minimum="0" Maximum="64" />
                        </Grid>
                        <CheckBox Content="Flat IQ (unified issue queue)" IsChecked="{Binding FlatIq}" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnDefinitions="400,*">

        <!-- ── Left panel: context-sensitive settings ───────────────────────── -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="0" Margin="0,0,0,16">

                    <!-- Title -->
                    <Border Padding="16,14,16,14">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right"
                                          IsChecked="{Binding IsDarkTheme}"
                                          Content="{Binding ThemeLabel}"
                                          VerticalAlignment="Center"
                                          Padding="8,3"
                                          FontSize="11" />
                            <TextBlock Text="Horologium  ·  Face"
                                       FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Separator />

                    <!-- ── Chart / Table sidebar ─────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsChartTableTab}">

                        <!-- Mode -->
                        <StackPanel Margin="16,12,16,0" Spacing="4" Orientation="Horizontal">
                            <ToggleSwitch IsChecked="{Binding IsMulticoreMode}"
                                          OnContent="Multi-hart" OffContent="Single config" />
                        </StackPanel>

                        <!-- Workload (single-config mode only — multi-hart mode has a fixed demo
                             program instead, see Experiment.RunMulticore) -->
                        <StackPanel Margin="16,12,16,12" Spacing="8" IsVisible="{Binding !IsMulticoreMode}">
                            <TextBlock Text="ISA" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                            <ComboBox ItemsSource="{Binding IsaOptions}"
                                      SelectedItem="{Binding SelectedIsa}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Text="WORKLOAD" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                            <ComboBox ItemsSource="{Binding WorkloadPresets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkloadPreset">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowBrowse}" ColumnSpacing="6">
                                <TextBox Grid.Column="0"
                                         Text="{Binding WorkloadPath}"
                                         PlaceholderText="Path to ELF binary…"
                                         IsReadOnly="True" />
                                <Button Grid.Column="1" Content="Browse…" Click="OnBrowseClick" />
                            </Grid>
                        </StackPanel>

                        <!-- Multi-hart settings -->
                        <StackPanel Margin="16,12,16,12" Spacing="8" IsVisible="{Binding IsMulticoreMode}">
                            <TextBlock Text="MULTI-HART" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                            <TextBlock
                                Text="Every hart runs the same fixed LR/SC demo program (real ELFs aren't safe to share across harts)."
                                FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Bus" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Static vm:MultiHartSettingsViewModel.BusKindOptions}"
                                          SelectedItem="{Binding MultiHartSettings.BusKind}"
                                          HorizontalAlignment="Stretch" />
                            </Grid>
                            <CheckBox IsChecked="{Binding MultiHartSettings.ConcurrentMode}"
                                      Content="Concurrent mode (two-phase parallel tick; snooping bus only)" />
                            <TextBlock Text="SHARED LLC" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                            <CheckBox IsChecked="{Binding MultiHartSettings.SharedLlcEnabled}" Content="Enabled" />
                            <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                                  RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4"
                                  IsVisible="{Binding MultiHartSettings.SharedLlcEnabled}">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Capacity (KiB)"
                                           VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="0" Grid.Column="1"
                                               Value="{Binding MultiHartSettings.SharedLlcCapacityKb}"
                                               Minimum="1" Maximum="131072" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ways" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="1" Grid.Column="1"
                                               Value="{Binding MultiHartSettings.SharedLlcWays}"
                                               Minimum="1" Maximum="32" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Block (bytes)" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="2" Grid.Column="1"
                                               Value="{Binding MultiHartSettings.SharedLlcBlockBytes}"
                                               Minimum="8" Maximum="256" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Miss latency" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="3" Grid.Column="1"
                                               Value="{Binding MultiHartSettings.SharedLlcMissLatency}"
                                               Minimum="1" Maximum="500" />
                            </Grid>
                            <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Max ticks" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding MultiHartSettings.MaxTicks}"
                                               Minimum="1" Maximum="1000000000"
                                               Increment="10000" FormatString="N0" />
                            </Grid>
                        </StackPanel>

                        <Separator />

                        <!-- Run settings (single-config mode only — multi-hart mode has its own
                             Max ticks field in the MULTI-HART panel above) -->
                        <StackPanel Margin="16,12,16,12" Spacing="8" IsVisible="{Binding !IsMulticoreMode}">
                            <TextBlock Text="RUN SETTINGS" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6"
                                  ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Max ticks" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="0" Grid.Column="1"
                                               Value="{Binding MaxTicks}"
                                               Minimum="1" Maximum="1000000000"
                                               Increment="100000" FormatString="N0" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Warmup ticks" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="1" Grid.Column="1"
                                               Value="{Binding WarmupTicks}"
                                               Minimum="0" Maximum="100000000"
                                               Increment="10000" FormatString="N0" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Snapshot interval"
                                           VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="2" Grid.Column="1"
                                               Value="{Binding SnapshotInterval}"
                                               Minimum="0" Maximum="1000000"
                                               Increment="1000" FormatString="N0" />
                            </Grid>
                            <TextBlock Text="Snapshot interval = 0 disables time series."
                                       FontSize="11" Opacity="0.45" />
                        </StackPanel>

                        <Separator />

                        <!-- Configurations -->
                        <StackPanel Margin="16,12,16,0" Spacing="8">
                            <DockPanel>
                                <TextBlock Text="CONFIGURATIONS" DockPanel.Dock="Left"
                                           FontSize="11" FontWeight="SemiBold" Opacity="0.55"
                                           VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                    <Button Content="+" ToolTip.Tip="Add config"
                                            Command="{Binding AddConfigCommand}" Padding="8,4" />
                                    <Button Content="⧉" ToolTip.Tip="Duplicate selected"
                                            Command="{Binding DuplicateConfigCommand}" Padding="8,4" />
                                    <Button Content="−" ToolTip.Tip="Remove selected"
                                            Command="{Binding RemoveConfigCommand}" Padding="8,4" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Configs}"
                                     SelectedItem="{Binding SelectedConfig, Mode=TwoWay}"
                                     MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ConfigViewModel">
                                        <StackPanel Spacing="2" Margin="2,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Pipeline}" FontSize="11" Opacity="0.55" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- Config detail -->
                        <ContentControl Margin="16,8,16,0"
                                        Content="{Binding SelectedConfig}"
                                        IsVisible="{Binding HasSelectedConfig}"
                                        ContentTemplate="{StaticResource ConfigDetailTemplate}" />

                        <!-- Multi-hart: per-hart private cache (NOT the cache section in the
                             template above — a hart's Train never receives it, see
                             HartCacheViewModel's doc comment) -->
                        <StackPanel Margin="16,12,16,0" Spacing="8"
                                    IsVisible="{Binding IsMulticoreMode}">
                            <TextBlock
                                Text="The cache settings above are ignored in multi-hart mode — configure this hart's private cache below instead."
                                FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                IsVisible="{Binding HasSelectedConfig}" />
                            <StackPanel Spacing="8"
                                        IsVisible="{Binding SelectedHartCache, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="MEMORY POOL" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                                <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="Pool" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding SelectedHartCache.PoolId}"
                                                   Minimum="0" Maximum="63" />
                                </Grid>
                                <TextBlock
                                    Text="Harts sharing a pool number share memory, coherence bus, and shared LLC; different pools are fully isolated from each other."
                                    FontSize="11" Opacity="0.6" TextWrapping="Wrap" />

                                <TextBlock Text="PRIVATE CACHE" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                                <CheckBox IsChecked="{Binding SelectedHartCache.Enabled}" Content="Enabled" />
                                <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                                      RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4"
                                      IsVisible="{Binding SelectedHartCache.Enabled}">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Capacity (KiB)"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                                   Value="{Binding SelectedHartCache.CapacityKb}"
                                                   Minimum="1" Maximum="16384" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ways" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                                   Value="{Binding SelectedHartCache.Ways}"
                                                   Minimum="1" Maximum="16" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Block (bytes)"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Row="2" Grid.Column="1"
                                                   Value="{Binding SelectedHartCache.BlockBytes}"
                                                   Minimum="8" Maximum="256" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Miss latency"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Row="3" Grid.Column="1"
                                                   Value="{Binding SelectedHartCache.MissLatency}"
                                                   Minimum="1" Maximum="200" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Run button -->
                        <StackPanel Margin="16,16,16,0" Spacing="8">
                            <Button Content="▶  Run Experiment"
                                    Command="{Binding RunCommand}"
                                    IsVisible="{Binding !IsMulticoreMode}"
                                    IsEnabled="{Binding !IsRunning}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="0,10" />
                            <Button Content="▶  Run Multi-hart"
                                    Command="{Binding RunMulticoreCommand}"
                                    IsVisible="{Binding IsMulticoreMode}"
                                    IsEnabled="{Binding !IsRunning}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="0,10" />
                            <ProgressBar IsIndeterminate="True"
                                         IsVisible="{Binding IsRunning}"
                                         Height="4" />
                        </StackPanel>

                    </StackPanel>

                    <!-- ── PEvents sidebar ───────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsPEventsTab}">

                        <Separator />

                        <!-- Workload -->
                        <StackPanel Margin="16,12,16,12" Spacing="8">
                            <TextBlock Text="ISA" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                            <ComboBox ItemsSource="{Binding IsaOptions}"
                                      SelectedItem="{Binding SelectedIsa}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Text="WORKLOAD" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                            <ComboBox ItemsSource="{Binding WorkloadPresets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkloadPreset">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowBrowse}" ColumnSpacing="6">
                                <TextBox Grid.Column="0"
                                         Text="{Binding WorkloadPath}"
                                         PlaceholderText="Path to ELF binary…"
                                         IsReadOnly="True" />
                                <Button Grid.Column="1" Content="Browse…" Click="OnBrowseClick" />
                            </Grid>
                        </StackPanel>

                        <Separator />

                        <!-- Configuration selector -->
                        <StackPanel Margin="16,12,16,0" Spacing="8">
                            <DockPanel>
                                <TextBlock Text="CONFIGURATION" DockPanel.Dock="Left"
                                           FontSize="11" FontWeight="SemiBold" Opacity="0.55"
                                           VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                    <Button Content="+" ToolTip.Tip="Add config"
                                            Command="{Binding AddConfigCommand}" Padding="8,4" />
                                    <Button Content="⧉" ToolTip.Tip="Duplicate selected"
                                            Command="{Binding DuplicateConfigCommand}" Padding="8,4" />
                                    <Button Content="−" ToolTip.Tip="Remove selected"
                                            Command="{Binding RemoveConfigCommand}" Padding="8,4" />
                                </StackPanel>
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding Configs}"
                                      SelectedItem="{Binding SelectedConfig, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ConfigViewModel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Pipeline}" FontSize="11" Opacity="0.55" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Config detail -->
                        <ContentControl Margin="16,4,16,0"
                                        Content="{Binding SelectedConfig}"
                                        IsVisible="{Binding HasSelectedConfig}"
                                        ContentTemplate="{StaticResource ConfigDetailTemplate}" />

                        <Separator Margin="0,12,0,0" />

                        <!-- Trace -->
                        <StackPanel Margin="16,12,16,0" Spacing="8">
                            <TextBlock Text="TRACE" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                            <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Max trace ticks" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding TraceMaxTicks}"
                                               Minimum="100" Maximum="1000000"
                                               Increment="1000" FormatString="N0" />
                            </Grid>
                            <TextBlock Text="Traces the selected configuration."
                                       FontSize="11" Opacity="0.45" />
                        </StackPanel>
                        <StackPanel Margin="16,8,16,0" Spacing="8">
                            <Button Content="▶  Trace Config"
                                    Command="{Binding TraceCommand}"
                                    IsEnabled="{Binding !IsTracing}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="0,10" />
                            <ProgressBar IsIndeterminate="True"
                                         IsVisible="{Binding IsTracing}"
                                         Height="4" />
                        </StackPanel>

                    </StackPanel>

                    <!-- ── Assembler sidebar ─────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsAssemblerTab}">

                        <!-- UVE Kernel sub-tab controls -->
                        <StackPanel IsVisible="{Binding IsUveKernelSubTab}">
                            <Separator />
                            <StackPanel Margin="16,12,16,12" Spacing="8">
                                <TextBlock Text="UVE CLANG" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                                <TextBox Text="{Binding UveClangPath}"
                                         PlaceholderText="Path to the patched UVE clang binary…" />
                                <TextBlock
                                    Text="The compile+link step also needs riscv64-unknown-linux-musl-gcc on PATH (flake.nix)."
                                    FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>

                            <Separator />

                            <!-- Configuration selector -->
                            <StackPanel Margin="16,12,16,0" Spacing="8">
                                <DockPanel>
                                    <TextBlock Text="CONFIGURATION" DockPanel.Dock="Left"
                                               FontSize="11" FontWeight="SemiBold" Opacity="0.55"
                                               VerticalAlignment="Center" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                        <Button Content="+" ToolTip.Tip="Add config"
                                                Command="{Binding AddConfigCommand}" Padding="8,4" />
                                        <Button Content="⧉" ToolTip.Tip="Duplicate selected"
                                                Command="{Binding DuplicateConfigCommand}" Padding="8,4" />
                                        <Button Content="−" ToolTip.Tip="Remove selected"
                                                Command="{Binding RemoveConfigCommand}" Padding="8,4" />
                                    </StackPanel>
                                </DockPanel>
                                <ComboBox ItemsSource="{Binding Configs}"
                                          SelectedItem="{Binding SelectedConfig, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ConfigViewModel">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding Pipeline}" FontSize="11" Opacity="0.55" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock
                                    Text="Needs the 'ooo' pipeline — the StreamingEngine only runs under that one (not even 'cpr')."
                                    FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Config detail -->
                            <ContentControl Margin="16,4,16,0"
                                            Content="{Binding SelectedConfig}"
                                            IsVisible="{Binding HasSelectedConfig}"
                                            ContentTemplate="{StaticResource ConfigDetailTemplate}" />

                            <Separator Margin="0,12,0,0" />

                            <!-- Run -->
                            <StackPanel Margin="16,12,16,0" Spacing="8">
                                <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="Max ticks" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding MaxTicks}"
                                                   Minimum="1" Maximum="1000000000"
                                                   Increment="100000" FormatString="N0" />
                                </Grid>
                                <Button Content="▶  Compile &amp; Run"
                                        Command="{Binding RunCompiledSourceCommand}"
                                        IsEnabled="{Binding !IsRunning}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="0,10" />
                                <ProgressBar IsIndeterminate="True"
                                             IsVisible="{Binding IsRunning}"
                                             Height="4" />
                            </StackPanel>
                        </StackPanel>

                        <!-- CPU sub-tab controls -->
                        <StackPanel IsVisible="{Binding !IsUveKernelSubTab}">

                            <Separator />

                            <!-- ISA selector -->
                            <StackPanel Margin="16,12,16,0" Spacing="6">
                                <TextBlock Text="ISA" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                                <ComboBox ItemsSource="{Binding Assembler.IsaOptions}"
                                          SelectedItem="{Binding Assembler.SelectedIsa}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Language selector -->
                            <StackPanel Margin="16,12,16,0" Spacing="6">
                                <TextBlock Text="LANGUAGE" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                    <RadioButton Grid.Column="0"
                                                 Content="RISC-V ASM"
                                                 GroupName="EditorLanguage"
                                                 IsChecked="{Binding !Assembler.IsCMode, Mode=TwoWay}" />
                                    <RadioButton Grid.Column="1"
                                                 Content="C"
                                                 GroupName="EditorLanguage"
                                                 IsChecked="{Binding Assembler.IsCMode, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="90,*" ColumnSpacing="4"
                                      IsVisible="{Binding Assembler.IsCMode}">
                                    <TextBlock Grid.Column="0" Text="Optimization"
                                               VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Assembler.OptLevelOptions}"
                                              SelectedItem="{Binding Assembler.OptLevel}"
                                              HorizontalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>

                            <!-- ISA extension selector -->
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="16,12,16,0"
                                    Padding="12,10">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Margin="4,2" Width="160">
                                            <TextBlock Text="EXTENSIONS"
                                                       FontSize="10" FontWeight="SemiBold" Opacity="0.55"
                                                       Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding Assembler.AvailableExtensions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ExtensionToggle">
                                                        <CheckBox IsChecked="{Binding IsEnabled}"
                                                                  Content="{Binding Name}"
                                                                  Margin="0,3" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="ISA Extensions"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <TextBlock Text="{Binding Assembler.GasArchString}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11"
                                                   Opacity="0.55" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="›"
                                               VerticalAlignment="Center"
                                               Opacity="0.4"
                                               FontSize="18"
                                               Margin="8,0,0,0" />
                                </Grid>
                            </Button>

                            <!-- Pipeline mode selector -->
                            <StackPanel Margin="16,12,16,0" Spacing="6">
                                <TextBlock Text="PIPELINE" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                                <ComboBox ItemsSource="{Binding Assembler.PipelineModeLabels}"
                                          SelectedItem="{Binding Assembler.PipelineModeLabel}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Cache config — only shown in pipelined modes -->
                            <StackPanel IsVisible="{Binding Assembler.IsPipelineMode}"
                                        Margin="16,12,16,0" Spacing="8">
                                <TextBlock Text="CACHE" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />

                                <!-- I-Cache -->
                                <CheckBox IsChecked="{Binding Assembler.ICacheEnabled}"
                                          Content="I-DoCache" />
                                <StackPanel IsVisible="{Binding Assembler.ICacheEnabled}" Spacing="4" Margin="12,0,0,0">
                                    <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0" Text="Capacity"
                                                   VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Assembler.CacheCapacityKbOptions}"
                                                  SelectedItem="{Binding Assembler.ICacheCapacityKb}"
                                                  HorizontalAlignment="Stretch" />
                                        <TextBlock Grid.Column="2" Text="KB"
                                                   VerticalAlignment="Center" FontSize="11" Opacity="0.6" />
                                    </Grid>
                                    <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0" Text="Ways"
                                                   VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Assembler.CacheWaysOptions}"
                                                  SelectedItem="{Binding Assembler.ICacheWays}"
                                                  HorizontalAlignment="Stretch" />
                                        <TextBlock Grid.Column="2" Text="  "
                                                   VerticalAlignment="Center" FontSize="11" />
                                    </Grid>
                                    <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0" Text="Block"
                                                   VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Assembler.CacheBlockBytesOptions}"
                                                  SelectedItem="{Binding Assembler.ICacheBlockBytes}"
                                                  HorizontalAlignment="Stretch" />
                                        <TextBlock Grid.Column="2" Text="B"
                                                   VerticalAlignment="Center" FontSize="11" Opacity="0.6" />
                                    </Grid>
                                    <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0" Text="Miss"
                                                   VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                                        <NumericUpDown Grid.Column="1"
