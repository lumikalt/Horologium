<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Face.ViewModels"
        xmlns:views="using:Face.Views"
        xmlns:controls="using:Face.Controls"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        x:Class="Face.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Horologium — Face"
        Width="1340" Height="860"
        MinWidth="900" MinHeight="600">

    <!-- Shared config-detail template — used by both Chart/Table and PEvents sidebars -->
    <Window.Resources>
        <DataTemplate x:Key="ConfigDetailTemplate" x:DataType="vm:ConfigViewModel">
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="12">
                <StackPanel Spacing="8">

                    <!-- Name -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Name" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Name}" />
                    </Grid>

                    <!-- Pipeline -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Pipeline" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PipelineOptions}"
                                  SelectedItem="{Binding Pipeline}"
                                  HorizontalAlignment="Stretch" />
                    </Grid>

                    <!-- five_stage: forwarding -->
                    <CheckBox IsChecked="{Binding ForwardingEnabled}"
                              Content="Forwarding enabled"
                              IsVisible="{Binding IsFiveStage}" />

                    <!-- Predictor (five_stage + ooo) -->
                    <StackPanel IsVisible="{Binding !IsWidePipeline}" Spacing="6">
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="Branch predictor" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding PredictorOptions}"
                                      SelectedItem="{Binding PredictorType}"
                                      HorizontalAlignment="Stretch" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasNBitParams}">
                            <TextBlock Grid.Column="0" Text="Bits" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding PredictorBits}"
                                           Minimum="1" Maximum="8" Increment="1" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasNBitParams}">
                            <TextBlock Grid.Column="0" Text="Table size" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding PredictorTableSize}"
                                           Minimum="4" Maximum="65536" Increment="256" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasGshareParams}">
                            <TextBlock Grid.Column="0" Text="History bits" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding PredictorHistoryBits}"
                                           Minimum="1" Maximum="32" Increment="1" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasGselectParams}">
                            <TextBlock Grid.Column="0" Text="PC bits" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding PredictorPcBits}"
                                           Minimum="1" Maximum="16" Increment="1" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasCorrelatedParams}">
                            <TextBlock Grid.Column="0" Text="M (hist bits)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding CorrelatedM}"
                                           Minimum="1" Maximum="16" Increment="1" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasCorrelatedParams}">
                            <TextBlock Grid.Column="0" Text="N (counter bits)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding CorrelatedN}"
                                           Minimum="1" Maximum="8" Increment="1" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasCorrelatedParams}">
                            <TextBlock Grid.Column="0" Text="BHT size" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding CorrelatedBhtSize}"
                                           Minimum="4" Maximum="65536" Increment="256" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasPerceptronParams}">
                            <TextBlock Grid.Column="0" Text="History length" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding PerceptronHistoryLength}"
                                           Minimum="1" Maximum="256" Increment="4" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasPerceptronParams}">
                            <TextBlock Grid.Column="0" Text="Table size" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding PerceptronTableSize}"
                                           Minimum="4" Maximum="65536" Increment="256" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasHashedPerceptronParams}">
                            <TextBlock Grid.Column="0" Text="Table size" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding HashedPerceptronTableSize}"
                                           Minimum="4" Maximum="65536" Increment="256" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasTournamentParams}">
                            <TextBlock Grid.Column="0" Text="Local hist bits" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding TournamentLocalHistoryBits}"
                                           Minimum="1" Maximum="16" Increment="1" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasTournamentParams}">
                            <TextBlock Grid.Column="0" Text="Local table" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding TournamentLocalTableSize}"
                                           Minimum="4" Maximum="65536" Increment="256" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding HasTournamentParams}">
                            <TextBlock Grid.Column="0" Text="Global hist bits" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding TournamentGlobalHistoryBits}"
                                           Minimum="1" Maximum="32" Increment="1" />
                        </Grid>
                    </StackPanel>

                    <!-- five_stage: I-cache -->
                    <StackPanel IsVisible="{Binding IsFiveStage}" Spacing="6">
                        <CheckBox IsChecked="{Binding ICacheEnabled}" Content="I-cache" />
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding ICacheEnabled}"
                              RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Capacity (KiB)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding ICacheCapacityKb}"
                                           Minimum="1" Maximum="16384" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ways" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ICacheWays}"
                                           Minimum="1" Maximum="16" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Block (bytes)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ICacheBlockBytes}"
                                           Minimum="8" Maximum="256" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Miss latency" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding ICacheMissLatency}"
                                           Minimum="1" Maximum="200" />
                        </Grid>
                    </StackPanel>

                    <!-- five_stage: D-cache -->
                    <StackPanel IsVisible="{Binding IsFiveStage}" Spacing="6">
                        <CheckBox IsChecked="{Binding DCacheEnabled}" Content="D-cache" />
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              IsVisible="{Binding DCacheEnabled}"
                              RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Capacity (KiB)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding DCacheCapacityKb}"
                                           Minimum="1" Maximum="16384" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ways" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding DCacheWays}"
                                           Minimum="1" Maximum="16" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Block (bytes)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding DCacheBlockBytes}"
                                           Minimum="8" Maximum="256" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Miss latency" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding DCacheMissLatency}"
                                           Minimum="1" Maximum="200" />
                        </Grid>
                    </StackPanel>

                    <!-- five_stage: store buffer -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                          IsVisible="{Binding IsFiveStage}">
                        <TextBlock Grid.Column="0" Text="Store buffer" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding StoreBufferCapacity}"
                                       Minimum="0" Maximum="64" />
                    </Grid>

                    <!-- superscalar / ooo: issue width -->
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                          IsVisible="{Binding IsWidePipeline}">
                        <TextBlock Grid.Column="0" Text="Issue width" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding IssueWidth}"
                                       Minimum="1" Maximum="16" />
                    </Grid>

                    <!-- ooo: ROB / IQ / phys regs -->
                    <StackPanel IsVisible="{Binding IsOoo}" Spacing="6">
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8"
                              RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ROB capacity" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding RobCapacity}"
                                           Minimum="4" Maximum="512" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="IQ capacity" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding IqCapacity}"
                                           Minimum="4" Maximum="256" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Extra phys regs" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ExtraPhysRegs}"
                                           Minimum="0" Maximum="256" />
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid ColumnDefinitions="400,*">

        <!-- ── Left panel: context-sensitive settings ───────────────────────── -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="0" Margin="0,0,0,16">

                    <!-- Title -->
                    <Border Padding="16,14,16,14">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right"
                                          IsChecked="{Binding IsDarkTheme}"
                                          Content="{Binding ThemeLabel}"
                                          VerticalAlignment="Center"
                                          Padding="8,3"
                                          FontSize="11" />
                            <TextBlock Text="Horologium  ·  Face"
                                       FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Separator />

                    <!-- ── Chart / Table sidebar ─────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsChartTableTab}">

                        <!-- Workload -->
                        <StackPanel Margin="16,12,16,12" Spacing="8">
                            <TextBlock Text="WORKLOAD" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                            <ComboBox ItemsSource="{Binding WorkloadPresets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkloadPreset">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowBrowse}" ColumnSpacing="6">
                                <TextBox Grid.Column="0"
                                         Text="{Binding WorkloadPath}"
                                         PlaceholderText="Path to ELF binary…"
                                         IsReadOnly="True" />
                                <Button Grid.Column="1" Content="Browse…" Click="OnBrowseClick" />
                            </Grid>
                        </StackPanel>

                        <Separator />

                        <!-- Run settings -->
                        <StackPanel Margin="16,12,16,12" Spacing="8">
                            <TextBlock Text="RUN SETTINGS" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6"
                                  ColumnSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Max ticks" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="0" Grid.Column="1"
                                               Value="{Binding MaxTicks}"
                                               Minimum="1" Maximum="1000000000"
                                               Increment="100000" FormatString="N0" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Warmup ticks" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="1" Grid.Column="1"
                                               Value="{Binding WarmupTicks}"
                                               Minimum="0" Maximum="100000000"
                                               Increment="10000" FormatString="N0" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Snapshot interval"
                                           VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="2" Grid.Column="1"
                                               Value="{Binding SnapshotInterval}"
                                               Minimum="0" Maximum="1000000"
                                               Increment="1000" FormatString="N0" />
                            </Grid>
                            <TextBlock Text="Snapshot interval = 0 disables time series."
                                       FontSize="11" Opacity="0.45" />
                        </StackPanel>

                        <Separator />

                        <!-- Configurations -->
                        <StackPanel Margin="16,12,16,0" Spacing="8">
                            <DockPanel>
                                <TextBlock Text="CONFIGURATIONS" DockPanel.Dock="Left"
                                           FontSize="11" FontWeight="SemiBold" Opacity="0.55"
                                           VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                    <Button Content="+" ToolTip.Tip="Add config"
                                            Command="{Binding AddConfigCommand}" Padding="8,4" />
                                    <Button Content="⧉" ToolTip.Tip="Duplicate selected"
                                            Command="{Binding DuplicateConfigCommand}" Padding="8,4" />
                                    <Button Content="−" ToolTip.Tip="Remove selected"
                                            Command="{Binding RemoveConfigCommand}" Padding="8,4" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Configs}"
                                     SelectedItem="{Binding SelectedConfig, Mode=TwoWay}"
                                     MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ConfigViewModel">
                                        <StackPanel Spacing="2" Margin="2,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Pipeline}" FontSize="11" Opacity="0.55" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- Config detail -->
                        <ContentControl Margin="16,8,16,0"
                                        Content="{Binding SelectedConfig}"
                                        IsVisible="{Binding HasSelectedConfig}"
                                        ContentTemplate="{StaticResource ConfigDetailTemplate}" />

                        <!-- Run button -->
                        <StackPanel Margin="16,16,16,0" Spacing="8">
                            <Button Content="▶  Run Experiment"
                                    Command="{Binding RunCommand}"
                                    IsEnabled="{Binding !IsRunning}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="0,10" />
                            <ProgressBar IsIndeterminate="True"
                                         IsVisible="{Binding IsRunning}"
                                         Height="4" />
                        </StackPanel>

                    </StackPanel>

                    <!-- ── PEvents sidebar ───────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsPEventsTab}">

                        <Separator />

                        <!-- Workload -->
                        <StackPanel Margin="16,12,16,12" Spacing="8">
                            <TextBlock Text="WORKLOAD" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                            <ComboBox ItemsSource="{Binding WorkloadPresets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkloadPreset">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowBrowse}" ColumnSpacing="6">
                                <TextBox Grid.Column="0"
                                         Text="{Binding WorkloadPath}"
                                         PlaceholderText="Path to ELF binary…"
                                         IsReadOnly="True" />
                                <Button Grid.Column="1" Content="Browse…" Click="OnBrowseClick" />
                            </Grid>
                        </StackPanel>

                        <Separator />

                        <!-- Configuration selector -->
                        <StackPanel Margin="16,12,16,0" Spacing="8">
                            <DockPanel>
                                <TextBlock Text="CONFIGURATION" DockPanel.Dock="Left"
                                           FontSize="11" FontWeight="SemiBold" Opacity="0.55"
                                           VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                    <Button Content="+" ToolTip.Tip="Add config"
                                            Command="{Binding AddConfigCommand}" Padding="8,4" />
                                    <Button Content="⧉" ToolTip.Tip="Duplicate selected"
                                            Command="{Binding DuplicateConfigCommand}" Padding="8,4" />
                                    <Button Content="−" ToolTip.Tip="Remove selected"
                                            Command="{Binding RemoveConfigCommand}" Padding="8,4" />
                                </StackPanel>
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding Configs}"
                                      SelectedItem="{Binding SelectedConfig, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ConfigViewModel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Pipeline}" FontSize="11" Opacity="0.55" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Config detail -->
                        <ContentControl Margin="16,4,16,0"
                                        Content="{Binding SelectedConfig}"
                                        IsVisible="{Binding HasSelectedConfig}"
                                        ContentTemplate="{StaticResource ConfigDetailTemplate}" />

                        <Separator Margin="0,12,0,0" />

                        <!-- Trace -->
                        <StackPanel Margin="16,12,16,0" Spacing="8">
                            <TextBlock Text="TRACE" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                            <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Max trace ticks" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding TraceMaxTicks}"
                                               Minimum="100" Maximum="1000000"
                                               Increment="1000" FormatString="N0" />
                            </Grid>
                            <TextBlock Text="Traces the selected configuration."
                                       FontSize="11" Opacity="0.45" />
                        </StackPanel>
                        <StackPanel Margin="16,8,16,0" Spacing="8">
                            <Button Content="▶  Trace Config"
                                    Command="{Binding TraceCommand}"
                                    IsEnabled="{Binding !IsTracing}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="0,10" />
                            <ProgressBar IsIndeterminate="True"
                                         IsVisible="{Binding IsTracing}"
                                         Height="4" />
                        </StackPanel>

                    </StackPanel>

                    <!-- ── Assembler sidebar ─────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsAssemblerTab}">

                        <Separator />

                        <StackPanel Margin="16,12,16,12" Spacing="12">
                            <TextBlock Text="ASSEMBLER" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />

                            <!-- ms / cycle chooser -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="ms / cycle" FontSize="11" Opacity="0.55" />
                                <NumericUpDown Value="{Binding Assembler.MsPerCycle}"
                                               Minimum="0" Maximum="5000"
                                               Increment="10" FormatString="N0"
                                               HorizontalAlignment="Stretch" />
                                <TextBlock Text="0 = run as fast as possible."
                                           FontSize="11" Opacity="0.45" />
                            </StackPanel>

                            <!-- Transport buttons: ←  |▶  →  ↺ -->
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                <Button Grid.Column="0" Content="←"
                                        Command="{Binding Assembler.BackCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        FontSize="16" Padding="0,8" />
                                <Button Grid.Column="1" Content="|▶"
                                        Command="{Binding Assembler.RunCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        FontSize="16" Padding="0,8" />
                                <Button Grid.Column="2" Content="→"
                                        Command="{Binding Assembler.StepCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        FontSize="16" Padding="0,8" />
                                <Button Grid.Column="3" Content="↺"
                                        Command="{Binding Assembler.ResetCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        FontSize="16" Padding="0,8" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                <TextBlock Grid.Column="0" Text="Back"
                                           TextAlignment="Center" FontSize="10" Opacity="0.45" />
                                <TextBlock Grid.Column="1" Text="Run"
                                           TextAlignment="Center" FontSize="10" Opacity="0.45" />
                                <TextBlock Grid.Column="2" Text="Step"
                                           TextAlignment="Center" FontSize="10" Opacity="0.45" />
                                <TextBlock Grid.Column="3" Text="Reset"
                                           TextAlignment="Center" FontSize="10" Opacity="0.45" />
                            </Grid>
                        </StackPanel>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── Right panel: results ─────────────────────────────────────────── -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Status bar -->
            <Border Grid.Row="0" Padding="12,8"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding StatusText}" Opacity="0.75" />
            </Border>

            <!-- Tabs -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">

                <!-- Charts tab (Chart + Table as sub-tabs) -->
                <TabItem Header="Charts">
                    <TabControl>
                        <TabItem Header="Chart">
                            <Grid RowDefinitions="Auto,*">
                                <DockPanel Grid.Row="0" Margin="12,8" LastChildFill="True">
                                    <TextBlock Text="Metric: " DockPanel.Dock="Left"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding AvailableMetrics}"
                                              SelectedItem="{Binding SelectedMetric}"
                                              MinWidth="240" />
                                </DockPanel>
                                <sp:AvaPlot x:Name="ChartView" Grid.Row="1" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Table">
                            <DataGrid x:Name="ResultsGrid"
                                      IsReadOnly="True"
                                      CanUserSortColumns="True"
                                      CanUserResizeColumns="True"
                                      GridLinesVisibility="All"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto" />
                        </TabItem>
                    </TabControl>
                </TabItem>

                <!-- PEvents tab -->
                <TabItem Header="PEvents">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Padding="12,7"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding PEventStatusText}" Opacity="0.75" FontSize="12" />
                        </Border>
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <controls:WaterfallControl Data="{Binding CurrentWaterfall}"
                                                       IsDark="{Binding IsDarkTheme}" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Assembler tab -->
                <TabItem Header="Assembler">
                    <views:AssemblerView DataContext="{Binding Assembler}" />
                </TabItem>

            </TabControl>
        </Grid>

    </Grid>
</Window>