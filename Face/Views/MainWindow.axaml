<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Face.Views"
        xmlns:vm="using:Face.ViewModels"
        x:Class="Face.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Horologium — Face"
        Width="1340" Height="860"
        MinWidth="900" MinHeight="600">
    <Grid>
        <views:LauncherView IsVisible="{Binding IsLauncherPage}" />
        <views:MainPanel IsVisible="{Binding IsRiscVPage}" />
        <Grid IsVisible="{Binding IsChip8Page}">
            <views:Chip8View DataContext="{Binding Chip8}" />
        </Grid>
    </Grid>
</Window>